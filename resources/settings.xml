<?xml version="1.0" ?>
<settings version="1">
    <section id="service.subtitles.opensubtitles-com">
        <category id="user" label="32101">
            <group id="1">
                <setting id="OSuser" type="string" label="32201">
                    <level>0</level>
                    <default/>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>32201</heading>
                    </control>
                </setting>
                <setting id="OSpass" type="string" label="32202">
                    <level>0</level>
                    <default/>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <control type="edit" format="string">
                        <heading>32202</heading>
                        <hidden>true</hidden>
                    </control>
                </setting>
                <setting id="account_is_vip" type="string">
                    <level>4</level>
                    <default>false</default>
                </setting>
                <setting id="account_logged_in" type="string">
                    <level>4</level>
                    <default>false</default>
                </setting>
                <setting id="test_connection" type="action" label="32010">
                    <level>0</level>
                    <default/>
                    <control type="button" format="action">
                        <!-- <close> makes Kodi save the settings and close this dialog before
                             running the script. Without it the script reads the values last
                             written to disk, so freshly typed credentials look empty and the
                             user is asked for a username and password they just entered. -->
                        <close>true</close>
                        <data>RunScript(special://home/addons/service.subtitles.opensubtitles-com/test_connection.py)</data>
                    </control>
                </setting>
                <setting id="show_register_qr" type="action" label="32258">
                    <level>0</level>
                    <default/>
                    <dependencies>
                        <!-- Registration only matters while sign-in is not working:
                             never verified, wrong password, email-as-username... -->
                        <dependency type="visible" setting="account_logged_in" operator="is">false</dependency>
                    </dependencies>
                    <control type="button" format="action">
                        <close>true</close>
                        <data>RunScript(special://home/addons/service.subtitles.opensubtitles-com/show_qr.py, register)</data>
                    </control>
                </setting>
                <setting id="account_status" type="string" label="32204">
                    <level>0</level>
                    <default>Not Verified</default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <dependencies>
                        <dependency type="enable" setting="account_status" operator="is">__disabled__</dependency>
                        <!-- One line per account state: a logged-in free user sees the
                             combined "Free account - Buy VIP" button instead of this row -->
                        <dependency type="visible">
                            <or>
                                <condition setting="account_is_vip" operator="is">true</condition>
                                <condition setting="account_logged_in" operator="is">false</condition>
                            </or>
                        </dependency>
                    </dependencies>
                    <control type="edit" format="string">
                        <heading>32204</heading>
                    </control>
                </setting>
                <setting id="show_vip_qr" type="action" label="32264">
                    <level>0</level>
                    <default/>
                    <dependencies>
                        <!-- The single account line for logged-in free users:
                             status and upsell combined, click shows the VIP QR -->
                        <dependency type="visible" setting="account_is_vip" operator="is">false</dependency>
                        <dependency type="visible" setting="account_logged_in" operator="is">true</dependency>
                    </dependencies>
                    <control type="button" format="action">
                        <close>true</close>
                        <data>RunScript(special://home/addons/service.subtitles.opensubtitles-com/show_qr.py, vip)</data>
                    </control>
                </setting>
                <setting id="account_details" type="string" label="32205">
                    <level>0</level>
                    <default>Click Test Connection to verify</default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <dependencies>
                        <dependency type="visible" setting="account_logged_in" operator="is">true</dependency>
                        <dependency type="enable" setting="account_details" operator="is">__disabled__</dependency>
                    </dependencies>
                    <control type="edit" format="string">
                        <heading>32205</heading>
                    </control>
                </setting>
                <setting id="ai_credits" type="string" label="32265">
                    <level>0</level>
                    <default>Sign in to view</default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <dependencies>
                        <dependency type="visible" setting="account_logged_in" operator="is">true</dependency>
                    </dependencies>
                    <!-- One line: label left, credits + [ BUY ] hint right, click runs
                         the purchase flow. A string setting with a button/action
                         control shows its VALUE and stays clickable - the pattern
                         that merges a read-only row and a button into one. -->
                    <control type="button" format="action">
                        <close>true</close>
                        <data>RunScript(special://home/addons/service.subtitles.opensubtitles-com/buy_credits.py)</data>
                    </control>
                </setting>
                <setting id="account_checked_at" type="string" label="32206">
                    <level>0</level>
                    <default>Not yet checked</default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                    <dependencies>
                        <dependency type="visible" setting="account_logged_in" operator="is">true</dependency>
                        <dependency type="enable" setting="account_checked_at" operator="is">__disabled__</dependency>
                    </dependencies>
                    <control type="edit" format="string">
                        <heading>32206</heading>
                    </control>
                </setting>
                <setting id="account_verified_at" type="string">
                    <level>4</level>
                    <default>0</default>
                </setting>
                <setting id="account_credentials_fingerprint" type="string">
                    <level>4</level>
                    <default></default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                </setting>
                <setting id="account_alert_state" type="string">
                    <level>4</level>
                    <default></default>
                    <constraints>
                        <allowempty>true</allowempty>
                    </constraints>
                </setting>
                <setting id="APIKey" type="string">
                    <level>4</level>
                    <default>qo2wQs1PXwIHJsXvIiWXu1ZbVjaboPh6</default>
                </setting>
            </group>
        </category>
