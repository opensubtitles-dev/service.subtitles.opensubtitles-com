<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.opensubtitles.smoketest"
       name="OpenSubtitles Smoke Test"
       version="1.0.0"
       provider-name="opensubtitles">
	<requires>
		<import addon="xbmc.python" version="3.0.0"/>
		<!-- Kodi only adds a script.module's lib dir to sys.path for add-ons
		     that declare it - without this line the target add-on's modules
		     cannot resolve 'requests' when imported from this wrapper. -->
		<import addon="script.module.requests" version="2.25.1"/>
	</requires>
	<extension point="xbmc.service" library="service.py" />
	<extension point="xbmc.addon.metadata">
		<summary lang="en_GB">Imports every shipped opensubtitles-com module inside Kodi's real embedded Python and logs a machine-readable verdict. CI-only, never shipped.</summary>
		<platform>all</platform>
		<license>GPL-2.0-only</license>
	</extension>
</addon>
